module(name = "tinyemu", version = "2019.12.21")

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "apple_support", version = "2.9.1", repo_name = "build_bazel_apple_support")

# Hermetic emscripten toolchain for the WebAssembly build.
bazel_dep(name = "emsdk", version = "6.0.13")

emscripten_deps = use_extension("@emsdk//:emscripten_deps.bzl", "emscripten_deps")
emscripten_deps.config(version = "6.0.13")
use_repo(
    emscripten_deps,
    "emscripten_bin_linux",
    "emscripten_bin_linux_arm64",
    "emscripten_bin_mac",
    "emscripten_bin_mac_arm64",
)
